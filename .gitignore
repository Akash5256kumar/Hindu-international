# macOS
.DS_Store

# Created on the server by the admin panel — never commit
admin/data/credentials.php
admin/data/login-attempts.json
admin/data/backups/*
!admin/data/backups/.gitkeep

# Files uploaded through the admin panel live on the server
uploads/*
!uploads/.htaccess
!uploads/.gitkeep

# Admin-managed content lives here; never tracked by git so deployments can't overwrite it.
# On first admin access after deploy, the PHP copies content.json → site.json automatically.
content/site.json
content/site.js

# Deployment archives
*.zip
