# Virtual Punya Snan — Apache / Hostinger settings
Options -Indexes
DirectoryIndex index.html

<IfModule mod_deflate.c>
  # The server labels .js files text/javascript, so both names are listed
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json
</IfModule>

# Let browsers keep files instead of downloading them on every visit (mod_expires is not
# enabled on the server, so this uses mod_headers). Stylesheets and scripts are linked with
# ?v=… — change that version whenever a file changes. content.js is set to no-cache below.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Tell crawlers whether each public page can be indexed. Privacy and Terms remain noindex.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/$|^/(?:about|how-it-works|protect-our-faith|donate|event|booking|contact)(?:\.html)?/?$" seo_public_page
  SetEnvIf Request_URI "^/(?:privacy|terms)(?:\.html)?/?$" seo_noindex_page
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "index, follow" env=seo_public_page
  Header always set X-Robots-Tag "noindex, follow" env=seo_noindex_page
</IfModule>

# The admin rewrites this file in place, so browsers must revalidate it to see new content and image paths.
<Files "content.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </IfModule>
</Files>

# Never serve the form settings file directly
<Files "config.php">
  Require all denied
</Files>

# "Preserve Our Roots" was renamed to "Protect Our Faith": send old links to the new page
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Image hotlink protection: other websites may not show our photos on their pages.
  # Allowed: this site, visits with no referrer (direct links, Google/Bing crawlers, WhatsApp and
  # Facebook link previews) and search engines' image results.
  RewriteCond %{REQUEST_URI} \.(?:jpe?g|png|gif|webp|avif|svg)$ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/media\.php$
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(?:www\.)?hindu\.international(?:/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(?:[\w-]+\.)*(?:google|bing|yahoo|duckduckgo|yandex|baidu)\.[a-z.]+(?:/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(?:[\w-]+\.)*(?:facebook|whatsapp|instagram|twitter|x|linkedin|pinterest)\.(?:com|net)(?:/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(?:localhost|127\.0\.0\.1)(?::\d+)?(?:/|$) [NC]
  RewriteRule ^ - [F]

  # One address for the whole site: www.hindu.international → hindu.international (same page)
  RewriteCond %{HTTP_HOST} ^www\.hindu\.international$ [NC]
  RewriteRule ^ https://hindu.international%{REQUEST_URI} [R=301,L,NE]

  # /sitemap.xml is built from the admin content by sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [END]

  # Preserve the old page name while using the canonical clean URL.
  RewriteRule ^preserve-our-roots(?:\.html)?/?$ /protect-our-faith [R=301,L,NE]

  # The home page canonical URL is the site root.
  RewriteRule ^index\.html$ / [R=301,L,NE]

  # Keep legacy .html links working, but send visitors to the extensionless URL.
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html(?:[?\s]) [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

  # Serve existing root-level .html pages at clean extensionless URLs.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9-]+)/?$ $1.html [END]
</IfModule>
