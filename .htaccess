# Virtual Punya Snan — Apache / Hostinger settings
Options -Indexes
DirectoryIndex index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Never serve the form settings file directly
<Files "config.php">
  Require all denied
</Files>

# "Preserve Our Roots" was renamed to "Protect Our Faith": send old links to the new page
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^preserve-our-roots\.html$ protect-our-faith.html [R=301,L]
</IfModule>
