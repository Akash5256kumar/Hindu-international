      "number": "01",
      "icon": "snan",
      "title": "Virtual Punya Snan Service",
      "text": "Arrange Punya Snan in your name at sacred destinations like Ganga.",
      "image": "assets/images/services/punya-snan.jpg",
      "imageAlt": "Holy water poured from cupped hands at the river ghat at sunrise",
      "link": "booking",
      "bannerTitle": "Virtual\nPunya Snan Service",
      "bannerAccent": "Punya Snan",
      "bannerImage": "assets/images/services/punya-snan/banner.jpg",
      "bannerImageAlt": "Temples and boats on the river ghats at sunrise",
      "aboutLabel": "About this service",
      "aboutTitle": "A sacred dip, offered in your name",
      "aboutText1": "Punya Snan is the holy bath taken in a sacred river on an auspicious day. It is believed to cleanse the mind, remove past sins and bring the blessings of the river goddess to the devotee and their family.",
      "aboutText2": "Many devotees cannot travel to Haridwar, Prayagraj or Varanasi because of distance, health or work. With Virtual Punya Snan, our priests take the sacred dip on your behalf with your name, gotra and photograph, following the full Vedic process.",
      "aboutImage": "assets/images/services/punya-snan/about.jpg",
      "aboutImageAlt": "A hand offering flowers on a leaf as holy water falls into the river at sunrise",
      "showShloka": true,
      "shloka": "गङ्गे च यमुने चैव गोदावरि सरस्वति।\nनर्मदे सिन्धु कावेरि जलेऽस्मिन् सन्निधिं कुरु॥",
      "receiveTitle": "What You",
      "receiveAccent": "Receive",
      "receiveSubtitle": "Everything done with full Vedic process",
      "receive": [
        {
          "icon": "edit",
          "title": "Sankalp in your name",
          "text": "The priest takes a sankalp with your name, gotra and wish before the snan.",
          "image": "assets/images/services/punya-snan/receive-sankalp.jpg",
          "imageAlt": "A priest holding an aarti thali with a lit diya"
        },
        {
          "icon": "camera",
          "title": "Snan with your photograph",
          "text": "Your photograph is carried into the holy water during the sacred dip.",
          "image": "assets/images/services/punya-snan/receive-photo.jpg",
          "imageAlt": "A photograph held above the holy river"
        },
        {
          "icon": "temple",
          "title": "Mantra and aarti",
          "text": "Snan mantras and a short aarti are performed at the ghat.",
          "image": "assets/images/services/punya-snan/receive-aarti.jpg",
          "imageAlt": "A priest performing aarti with lamps at the ghat"
        },
        {
          "icon": "video",
          "title": "Recorded video for you",
          "text": "You receive the full recorded video of the ritual to watch with family.",
          "image": "assets/images/services/punya-snan/receive-video.jpg",
          "imageAlt": "A camera recording the ritual at the river ghat"
        }
      ],
      "whyTitle": "Why Choose Our",
      "whyAccent": "Virtual Punya Snan Service?",
      "why": [
        {
          "icon": "namaste",
          "title": "Stay Connected to Your Faith",
          "text": "Religious traditions are an important part of many people's lives. Our service offers a way to stay connected to Punya Snan when visiting the sacred place in person is difficult."
        },
        {
          "icon": "globe",
          "title": "Convenient for Devotees Everywhere",
          "text": "Not everyone can travel long distances for religious occasions. This service offers a convenient option for devotees living in different cities and countries."
        },
        {
          "icon": "temple",
          "title": "Respect for Hindu Traditions",
          "text": "We understand the importance of religious customs and spiritual beliefs. Our aim is to present this service with respect for the traditions associated with Punya Snan."
        },
        {
          "icon": "people",
          "title": "A Simple Way to Participate Remotely",
          "text": "You can enquire about the service, understand the available arrangements, and complete the booking process without planning a physical visit."
        }
      ],
      "whoTitle": "Who Can Use",
      "whoAccent": "This Service?",
      "whoIntro": "The Virtual Punya Snan Service may be suitable for:",
      "whoList": [
        {
          "text": "Devotees who cannot travel to sacred places."
        },
        {
          "text": "Families who wish to stay connected to Hindu religious traditions."
        },
        {
          "text": "Senior citizens who find long-distance travel difficult."
        },
        {
          "text": "People living outside India who want to maintain a connection with their religious roots."
        },
        {
          "text": "Individuals who wish to participate in religious traditions from their homes."
        }
      ],
      "whoClosing": "Every devotee has different circumstances. This service is intended to provide a convenient option for those who cannot visit the sacred location personally.",
      "showPlaces": true,
      "placesTitle": "Sacred Places",
      "placesSubtitle": "Explore the Sacred Ghats",
      "places": [
        {
          "name": "Har Ki Pauri",
          "location": "Haridwar · Ganga",
          "image": "assets/images/faith/hero-family.jpg",
          "imageAlt": "A family at the ghats with lamps at sunset"
        },
        {
          "name": "Triveni Sangam",
          "location": "Prayagraj · Ganga, Yamuna, Saraswati",
          "image": "assets/images/event-gathering.jpg",
          "imageAlt": "Devotees gathered at the sangam"
        },
        {
          "name": "Dashashwamedh Ghat",
          "location": "Varanasi · Ganga",
          "image": "assets/images/services/temple-darshan.jpg",
          "imageAlt": "Temples with saffron flags on the river ghat"
        }
      ],
      "faqTitle": "Frequently Asked Questions",
      "faqAccent": "(FAQs)",
      "faqs": [
        {
          "q": "What is a Virtual Punya Snan Service?",
          "a": "A Virtual Punya Snan Service allows devotees to participate remotely in arrangements associated with the sacred bathing tradition when they cannot visit the holy place in person."
        },
        {
          "q": "Can I book this service if I cannot travel to the holy place?",
          "a": "Yes. This service is intended for devotees who cannot travel because of distance, work, family responsibilities, health concerns, or other personal reasons."
        },
        {
          "q": "What details are required for the booking?",
          "a": "You may be asked to provide your name, gotra, wish, and photograph for the ritual arrangements. Please follow the booking instructions provided by the service team."
        },
        {
          "q": "Will I receive a video of the ritual?",
          "a": "Yes. As part of the described service, you receive a recorded video of the ritual so that you can watch it with your family."
        },
        {
          "q": "Can devotees living outside India use this service?",
          "a": "Devotees living outside India can enquire about availability and booking arrangements. Please confirm the applicable process and payment options before booking."
        }
      ],
      "ctaTitle": "Receive the blessings of the holy river",
      "ctaText": "Book your Virtual Punya Snan for the next auspicious day.",
      "ctaButton": "Book Punya Snan",
      "ctaLink": "booking",
      "ctaImage": "assets/images/services/punya-snan/cta.jpg",
      "seoTitle": "Virtual Punya Snan Service | Hindu.International",
      "seoDescription": "Our priests take the sacred dip at holy rivers on your behalf with your name, gotra and photograph, and share the recorded video with you."
